# Secrets — keep out of AI indexing and @-mentions (see harness/AGENT-INSTRUCTIONS.md)
.env
.env.*
!.env.example
!.env.sample
!.env.template

*.pem
*.key
credentials.json
secrets.json

# Junk context — dependencies, build output, and generated artifacts.
# Nothing here is source of truth; indexing it burns context and degrades
# retrieval. Mirrors the Read() deny rules in .claude/settings.json and the
# permission.read denies in opencode.jsonc (see harness/AGENT-INSTRUCTIONS.md).
node_modules/
dist/
build/
.next/
out/
.turbo/
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
__pycache__/
.venv/
venv/
package-lock.json
bun.lock
yarn.lock
pnpm-lock.yaml
*.min.js
*.min.css
*.map
